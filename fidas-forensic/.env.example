# ─── Server ───────────────────────────────────────────────
FLASK_PORT=8000
FLASK_ENV=development

# ─── MySQL (same credentials as Node.js backend) ─────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fidas_payments

# ─── Forensic Thresholds ──────────────────────────────────
ELA_VARIANCE_THRESHOLD=5.5
ELA_RESAVE_QUALITY=90
ELA_SCALE_FACTOR=10
LAPLACIAN_VARIANCE_THRESHOLD=100

# ─── Tesseract (set path if not in system PATH) ───────────
# TESSERACT_CMD=/usr/bin/tesseract
