# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/fidas_db

# ─── MySQL (FUTO Payment DB simulation) ──────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fidas_payments

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Bcrypt ───────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Nodemailer (Gmail SMTP) ──────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_fidas_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="FiDAS System <your_fidas_email@gmail.com>"

# ─── Python Forensic Microservice ─────────────────────────
PYTHON_SERVICE_URL=http://localhost:8000

# ─── File Upload ──────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# ─── Admin ────────────────────────────────────────────────
ADMIN_REGISTRATION_SECRET=fidas_admin_secret_2026
